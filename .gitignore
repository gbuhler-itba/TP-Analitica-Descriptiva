# =============================================================================
# .gitignore
# =============================================================================
# Los datasets del pipeline SÍ se versionan a propósito, para que cualquiera
# pueda clonar el repo y correr la cadena sin rehacer 8-15 h de scraping.
# Ver la sección "Qué viene versionado" del README.
#
# Lo que se ignora es todo lo que una corrida nueva regenera: parciales,
# logs, caches y artefactos de entorno.
# =============================================================================

# Parciales de corridas cortadas (el pipeline los borra al terminar bien)
data/raw/cuotas/*_parcial.tsv
data/interim/geocoding_parcial.tsv
**/*_parcial.tsv

# Logs y reportes de control de calidad de corridas nuevas.
# Son salida de trabajo y cada corrida los sobrescribe. La evidencia de la
# corrida documentada NO vive acá: está curada y versionada en
# docs/corrida-documentada/ para que un spot check no la pise.
outputs/logs/*
!outputs/logs/.gitkeep

# Cache de fuentes externas.
# El GeoJSON de estaciones de subte SÍ se versiona a propósito: congela el set
# de estaciones de la corrida documentada. Si BA Data publica una versión
# distinta, dist_transporte_m cambiaría sin que nadie toque una línea de
# código y el hash dejaría de reproducirse por un motivo invisible.
# Ver la sección 10 del README.
data/external/*
!data/external/.gitkeep
!data/external/estaciones-de-subte.geojson

# Directorio de salida de la estructura vieja, previo a la reorganización
output/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.ipynb_checkpoints/

# Entornos y editores
.env
.vscode/
.idea/

# macOS
.DS_Store
